<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.lifeos.atlas.plist.template — Source template. Install via:
    bun ~/.claude/LIFEOS/ATLAS/InstallAtlas.ts

  The installer reads $HOME at install time, substitutes the {{...}} placeholders,
  writes the materialized plist to ~/Library/LaunchAgents/, and bootstraps it with
  launchctl. This template stays clean of principal-specific paths so it ships in
  the public LifeOS release.

  Behavior:
    Runs `atlas tick` every 15 minutes (StartInterval 900) — cheap event-hint
    processing most ticks, a real full sync only once lastFullSyncAt is >1h old.
    WatchPaths on the hint file so a mutation captured by AtlasEventCapture.hook.ts
    triggers a targeted sync immediately instead of waiting out the interval.
    Fires once at boot (RunAtLoad true).
    Crash-loop rate-limited (ThrottleInterval 60s).
    stdout/stderr captured to MEMORY/OBSERVABILITY/atlas-launchd.log.

  ported from public PR #1743, @schmetti-dev
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifeos.atlas</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{HOME}}/.claude/LIFEOS/ATLAS/Atlas.ts</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>WatchPaths</key>
  <array>
    <string>{{HOME}}/.local/state/lifeos/atlas/events.jsonl</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>WorkingDirectory</key>
  <string>{{HOME}}/.claude</string>
  <key>StandardOutPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/OBSERVABILITY/atlas-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/.claude/LIFEOS/MEMORY/OBSERVABILITY/atlas-launchd.log</string>
</dict>
</plist>
