<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.lifeos.interviewdue.plist.template - Source template. Install via:
    bun ~/.claude/LIFEOS/TOOLS/InstallInterviewDue.ts
  Runs InterviewDue refresh daily at 07:10 (plus once at load): rebuilds the
  state-evidence, freshness, and interview-due caches that feed the statusline
  interview chip. Cache writes only - never touches claims files. The installer
  substitutes placeholders, writes the materialized plist to
  ~/Library/LaunchAgents/, and bootstraps it with launchctl. This template
  stays clean of principal-specific paths so it ships in the public release.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifeos.interviewdue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{LIFEOS_DIR}}/TOOLS/InterviewDue.ts</string>
    <string>--refresh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>{{LIFEOS_DIR}}/MEMORY/OBSERVABILITY/interview-due.log</string>
  <key>StandardErrorPath</key>
  <string>{{LIFEOS_DIR}}/MEMORY/OBSERVABILITY/interview-due.log</string>
  <key>WorkingDirectory</key>
  <string>{{CLAUDE_CONFIG_DIR}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>{{CLAUDE_CONFIG_DIR}}</string>
    <key>LIFEOS_DIR</key>
    <string>{{LIFEOS_DIR}}</string>
    <key>PATH</key>
    <string>{{BUN_DIR}}:{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
  </dict>
</dict>
</plist>
